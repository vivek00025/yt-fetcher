# Copy this file to .env and fill in your credentials

# Get these from https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# The URL Google will redirect to after login
# Must EXACTLY match what's registered in Google Cloud Console
REDIRECT_URI=http://localhost:3000/auth/callback

# Change this to a long random string in production
SESSION_SECRET=change-this-to-a-random-secret

PORT=3000
